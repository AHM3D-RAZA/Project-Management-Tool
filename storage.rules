rules_version = '2';

// Mirrors the workspace-membership checks in firestore.rules, but for
// Storage. Cross-service `firestore.get()` reads the same workspace
// document Firestore rules use, so a user's access here always matches
// their access to that workspace's tasks in Firestore.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function getWorkspace(workspaceId) {
      return firestore.get(/databases/(default)/documents/workspaces/$(workspaceId));
    }

    function isWorkspaceMember(workspaceId) {
      let ws = getWorkspace(workspaceId);
      return isSignedIn() &&
        (ws.data.ownerUserId == request.auth.uid || request.auth.uid in ws.data.memberRoles);
    }

    // Task attachments, uploaded via the "Upload File" button — see
    // src/lib/file-upload.ts. Path mirrors the task's Firestore location
    // (workspace/task) so this check can reuse the same membership data.
    match /workspaces/{workspaceId}/tasks/{taskId}/{fileName} {
      allow read: if isWorkspaceMember(workspaceId);
      allow write: if isWorkspaceMember(workspaceId)
                   && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isWorkspaceMember(workspaceId);
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
